# ScholarSync — variables d'environnement du déploiement Docker.
#
# Copiez ce fichier en .env puis remplissez les valeurs :
#   cp .env.example .env && ./scripts/generer-secrets.sh
#
# .env n'est jamais versionné. Ne remettez aucun secret dans
# docker-compose.yml : ce fichier-là part sur GitHub.

# Signature des cookies de session. Toute personne qui la connaît peut
# forger un cookie d'administrateur : elle doit être longue, aléatoire, et
# propre à chaque installation.
#   openssl rand -hex 32
SECRET_KEY=

# Base de données
POSTGRES_DB=scholarsync
POSTGRES_USER=scholarsync
#   openssl rand -base64 24
POSTGRES_PASSWORD=
